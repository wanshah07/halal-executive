# Copy this file to collectors/.env and fill it in once. All three collectors
# (whatsapp, telegram, facebook) read it. Never commit .env.

# Apps Script web app URL (Deploy -> Manage deployments -> Web app URL, ends in /exec)
HE_API_URL=https://script.google.com/macros/s/PASTE_ID_HERE/exec

# INGEST_TOKEN printed by setup() / showSecrets() in Apps Script
HE_INGEST_TOKEN=

# Exact group name as it shows in WhatsApp / Telegram (run: npm run groups)
HE_GROUP_NAME=Halal Executive
# Or the group id from `npm run groups` (ends in @g.us). It wins over the name.
# HE_GROUP_ID=

# Optional: browser for WhatsApp Web if Chrome/Edge is not found automatically
# HE_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Telegram only
# TELEGRAM_BOT_TOKEN=

# Facebook only
# FB_GROUP_URL=https://www.facebook.com/groups/...
